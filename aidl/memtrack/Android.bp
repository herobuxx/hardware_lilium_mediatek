cc_binary {
    name: "android.hardware.memtrack-service.mediatek",
    relative_install_path: "hw",
    init_rc: ["memtrack-mediatek.rc"],
    vintf_fragments: ["memtrack-mediatek.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "libutils",
        "liblog",
        "libbinder_ndk",
        "android.hardware.memtrack-V1-ndk",
        "libhardware",
        "libhardware_legacy",
    ],
    srcs: [
        "main.cpp",
        "Memtrack.cpp",
    ],
    static_libs: [
        "libdmabufinfo",
        "libcutils",
        "libutils",
    ],
}